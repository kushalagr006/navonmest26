{
  "expo": {
    "name": "Nex Guard",
    "slug": "nex-guard",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#f4f1eb"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "eas": {
        "projectId": "195804ad-e282-4b19-bc24-bfd47000c0f1"
      }
    },
    "owner": "kushalagr006",
    "android": {
      "package": "com.anshuman_verma.nexguard"
    },
    "plugins": [
      "expo-font",
      "expo-sqlite",
      "expo-secure-store",
      "expo-av",
      [
        "expo-notifications",
        {
          "color": "#DC2626",
          "sounds": [
            "./assets/emergency_alarm.mp3"
          ]
        }
      ]
    ]
  }
}
